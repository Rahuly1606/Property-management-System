# Database Configuration
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database }}
MYSQL_PORT=3307

# Backend Configuration
BACKEND_PORT={{ backend_port }}
SPRING_PROFILES_ACTIVE=docker

# Frontend Configuration
FRONTEND_PORT={{ frontend_port }}
VITE_API_URL=http://{{ ansible_host }}:{{ backend_port }}

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME={{ cloudinary_cloud_name | default('demo') }}
CLOUDINARY_API_KEY={{ cloudinary_api_key | default('') }}
CLOUDINARY_API_SECRET={{ cloudinary_api_secret | default('') }}

# Razorpay Configuration
RAZORPAY_KEY_ID={{ razorpay_key_id | default('') }}
RAZORPAY_KEY_SECRET={{ razorpay_key_secret | default('') }}

# JWT Configuration
JWT_SECRET={{ jwt_secret | default('your_jwt_secret_key_min_32_characters') }}
JWT_EXPIRATION=86400000
